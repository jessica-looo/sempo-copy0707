    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "def scale_ett_hour(df_raw, features='M', target='OT'):\n",
    "    scaler = StandardScaler()\n",
    "    \n",
    "    # 提取特征列\n",
    "    if features == 'M' or features == 'MS':\n",
    "        cols_data = df_raw.columns[1:] # 默认第一列为时间列\n",
    "        df_data = df_raw[cols_data]\n",
    "    elif features == 'S':\n",
    "        df_data = df_raw[[target]]\n",
    "        \n",
    "    # 定义训练集边界 (12个月 * 30天 * 24小时)\n",
    "    train_border = 12 * 30 * 24\n",
    "    train_data = df_data.iloc[0:train_border]\n",
    "    \n",
    "    # 拟合并转换\n",
    "    scaler.fit(train_data.values)\n",
    "    df_data = df_data.iloc[:14400]\n",
    "    scaled_data = scaler.transform(df_data.values)\n",
    "    \n",
    "    # 还原为 DataFrame\n",
    "    df_scaled = pd.DataFrame(scaled_data, columns=df_data.columns)\n",
    "    \n",
    "    # 拼接回原始的时间列（如果存在）\n",
    "    if 'date' in df_raw.columns:\n",
    "        df_scaled.insert(0, 'date', df_raw['date'])\n",
    "        \n",
    "    return df_scaled\n",
    "\n",
    "\n",
    "\n",
    "def scale_icecore_year(df_raw, seq_len=64, pred_len=16):\n",
    "    scaler = StandardScaler()\n",
    "    df_raw = df_raw.sort_values(by='year', ascending=True).reset_index(drop=True)\n",
    "    sites = [col for col in df_raw.columns if col != 'year']\n",
    "    \n",
    "    train_data_all = []\n",
    "    valid_sites = []\n",
    "    \n",
    "    # 第一步：收集所有站点的前 60% 数据\n",
    "    for site in sites:\n",
    "        df_site = df_raw[['year', site]].dropna()\n",
    "        length = len(df_site)\n",
    "        \n",
    "        if length < seq_len + pred_len:\n",
    "            continue\n",
    "            \n",
    "        valid_sites.append(site)\n",
    "        num_train = int(length * 0.6)\n",
    "        \n",
    "        # 截取该站点前 60% 用于拟合\n",
    "        train_data = df_site[[site]].values[0:num_train]\n",
    "        train_data_all.append(train_data)\n",
    "        \n",
    "    # 第二步：统一拟合 Scaler\n",
    "    if train_data_all:\n",
    "        scaler.fit(np.vstack(train_data_all))\n",
    "        \n",
    "    # 第三步：应用于全部数据\n",
    "    df_scaled = pd.DataFrame({'year': df_raw['year']})\n",
    "    for site in sites:\n",
    "        if site in valid_sites:\n",
    "            df_scaled[site] = scaler.transform(df_raw[[site]].values)\n",
    "        else:\n",
    "            # 长度不足的无效站点不进行 scale 处理\n",
    "            df_scaled[site] = df_raw[site]\n",
    "            \n",
    "    return df_scaled\n",
    "\n",
    "\n",
    "def scale_icecore_site(df_raw, seq_len=64, pred_len=16):\n",
    "    scaler = StandardScaler()\n",
    "    df_raw = df_raw.sort_values(by='year', ascending=True).reset_index(drop=True)\n",
    "    all_sites = [col for col in df_raw.columns if col != 'year']\n",
    "    \n",
    "    valid_sites, long_sites, short_sites = [], [], []\n",
    "    \n",
    "    # 第一步：筛选与分类站点\n",
    "    for site in all_sites:\n",
    "        df_site = df_raw[['year', site]].dropna()\n",
    "        length = len(df_site)\n",
    "        if length >= seq_len + pred_len:\n",
    "            valid_sites.append(site)\n",
    "            if length >= 200:\n",
    "                long_sites.append(site)\n",
    "            else:\n",
    "                short_sites.append(site)\n",
    "                \n",
    "    # 第二步：确定作为 Train 的站点集合\n",
    "    train_quota = int(len(valid_sites) * 0.6)\n",
    "    np.random.seed(2026)\n",
    "    np.random.shuffle(short_sites)\n",
    "    \n",
    "    train_sites = list(long_sites)\n",
    "    needed_for_train = max(0, train_quota - len(long_sites))\n",
    "    train_sites.extend(short_sites[:needed_for_train])\n",
    "    \n",
    "    # 第三步：仅用 Train 站点的非空数据拟合 Scaler\n",
    "    train_data_all = []\n",
    "    for site in train_sites:\n",
    "        df_site = df_raw[['year', site]].dropna()\n",
    "        train_data_all.append(df_site[[site]].values)\n",
    "        \n",
    "    if train_data_all:\n",
    "        scaler.fit(np.vstack(train_data_all))\n",
    "        \n",
    "    # 第四步：应用于全部数据\n",
    "    df_scaled = pd.DataFrame({'year': df_raw['year']})\n",
    "    for site in all_sites:\n",
    "        if site in valid_sites:\n",
    "            # StandardScaler 在遇到 NaN 时会返回 NaN，保留了原本的空缺结构\n",
    "            df_scaled[site] = scaler.transform(df_raw[[site]].values)\n",
    "        else:\n",
    "            # 长度不足的无效站点不进行 scale 处理\n",
    "            df_scaled[site] = df_raw[site]\n",
    "            \n",
    "    return df_scaled"
   ]
  },
