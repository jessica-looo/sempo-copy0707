    "    true_data_ic = np.load(true_path)\n",
    "    print(pred_data_ic_1.shape)\n",
    "    print(pred_data_ic_2.shape)\n",
    "\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    for i in range(min_idx, max_idx):\n",
    "        # 创建一张新图\n",
    "        plt.figure(figsize=(8, 4))\n",
    "        \n",
    "        y1 = pred_data_ic_1[i, :, 0]\n",
    "        y2 = pred_data_ic_2[i, :, 0]\n",
    "        y3 = true_data_ic[i, :, 0]\n",
    "       \n",
    "        # 绘制两条折线\n",
    "        plt.plot(y3, label='true', marker='o', linestyle='-')\n",
    "        plt.plot(y1, label='pred_ori', marker='x', linestyle='--')\n",
    "        plt.plot(y2, label='pred_scalar', marker='x', linestyle='--')\n",
    "\n",
    "        plt.ylim(-2, 5)\n",
    "        plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "\n",
    "        \n",
    "        plt.show()"
   ]
