   "source": [
    "full = pd.read_csv(\"dataset/icecore/merged_accumulation.csv\", index_col=0)\n",
    "full_pywt = pd.read_csv(\"dataset/icecore/merged_accumulation_pywt.csv\", index_col=0)"
   ]
  },
  {
   "cell_type": "code",
