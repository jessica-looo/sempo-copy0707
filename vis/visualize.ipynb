    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "import os\n",
    "\n",
    "# 1. 配置文件路径（请替换为你实际的数据文件路径）\n",
    "file_path = '/sharedata/home/cyyang/SEMPO/dataset/icecore/aligned_pywt.csv' \n",
    "\n",
    "# 2. 读取并排序数据\n",
    "df_raw = pd.read_csv(file_path)\n",
    "df_raw = df_raw.sort_values(by='year', ascending=True).reset_index(drop=True)\n",
    "\n",
    "# 3. 提取并清洗目标站点列\n",
    "all_sites = [col for col in df_raw.columns if col != 'year']\n",
    "east_antarctic_plateau_sites = [\n",
    "    \"vrs-13 (vostok stack)\", \"B31 3.43W \", \"B32 0.00667E\", \"B33 6.4983E\",\n",
    "    \"FB96DML01\", \"FB96DML02\", \"FB97DML03\", \"FB97DML04\", \"FB97DML05\",\n",
    "    \"FB97DML06\", \"FB97DML07\", \"FB97DML08\", \"FB97DML09\", \"FB97DML10\",\n",
    "    \"FB9803\", \"FB9804\", \"FB9805\", \"FB9807\", \"FB9808\", \"FB9809\", \"FB9810\",\n",
    "    \"FB9811\", \"FB9812\", \"FB9813\", \"FB9814\", \"FB9815\", \"FB9816\", \"FB9817\",\n",
    "    \"SPOLE 0EW \", \"GV2 145.2631 E\", \"D66 136.9352E\", \"LGB65 77.07472E\",\n",
    "    \"ITASE-02-7\", \"ITASE-02-4\"\n",
    "]\n",
    "\n",
    "# 清理格式以确保匹配准确\n",
    "clean_target_sites = [s.strip().replace('\"', '') for s in east_antarctic_plateau_sites]\n",
    "# 过滤提取目标站点\n",
    "all_sites = [s for s in all_sites if s.strip().replace('\"', '') in clean_target_sites]\n",
    "# 仅保留 year 列和目标站点列\n",
    "df_copy = df_raw[['year'] + all_sites].copy()\n",
    "\n",
    "# ================= 核心修改部分 =================\n",
    "# 4. 执行 StandardScaler 全局统一标准化\n",
    "# 提取时间轴与数值矩阵\n",
    "years = df_copy['year'].values\n",
    "data_values = df_copy[all_sites].values\n",
    "\n",
    "# 将二维矩阵 [样本数, 站点数] 展平成一维列向量 [样本数 * 站点数, 1]\n",
    "# 这样 scaler 就会把所有站点的数据看作同一个特征，计算出一个统一的全局均值和全局标准差\n",
    "flat_data = data_values.reshape(-1, 1)\n",
    "\n",
    "# 实例化并拟合转换数据（忽略 NaN 进行全局统计）\n",
    "scaler = StandardScaler()\n",
    "flat_scaled = scaler.fit_transform(flat_data)\n",
    "\n",
    "# 将缩放后的数据重新还原为原本的二维矩阵形状 [样本数, 站点数]\n",
    "scaled_values = flat_scaled.reshape(data_values.shape)\n",
    "# ===============================================\n",
    "\n",
    "# 5. 可视化绘制\n",
    "plt.figure(figsize=(16, 8))\n",
    "\n",
    "# 遍历每一个选中的站点进行绘制\n",
    "for i, site in enumerate(all_sites):\n",
    "    # 提取当前站点的标准化数据\n",
    "    site_data = scaled_values[:, i]\n",
    "    \n",
    "    # 关键处理：过滤掉 NaN 值，否则 Matplotlib 遇到 NaN 会导致连线断裂\n",
    "    valid_idx = ~np.isnan(site_data)\n",
    "    \n",
    "    # 绘制有效数据\n",
    "    plt.plot(years[valid_idx], site_data[valid_idx], label=site, alpha=0.7, linewidth=1.2)\n",
    "\n",
    "# 图表细节修饰\n",
    "plt.title('Globally Standardized Ice Core Accumulation - East Antarctic Plateau', fontsize=16, pad=15)\n",
    "plt.xlabel('Year', fontsize=14)\n",
    "plt.ylabel('Globally Standardized Value', fontsize=14)\n",
    "\n",
    "# 将图例放置在绘图区外部右侧，分两列显示以防止遮挡数据\n",
    "plt.legend(bbox_to_anchor=(1.01, 1), loc='upper left', ncol=2, fontsize=9)\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "\n",
    "# 自动调整布局，防止外部图例被裁切\n",
    "plt.tight_layout()\n",
    "\n",
    "# 如需保存到本地，可以取消下方代码注释\n",
    "# plt.savefig('east_antarctic_plateau_globally_scaled.png', dpi=300, bbox_inches='tight')\n",
    "\n",
    "plt.show()"
   ]
  },
