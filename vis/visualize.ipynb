   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv('dataset/icecore/merged_accumulation.csv')\n",
    "\n",
    "df['year'] = pd.to_numeric(df['year'], errors='coerce')\n",
    "\n",
    "results = []\n",
    "\n",
    "for col in df.columns:\n",
    "    if col != 'year':\n",
    "        valid_data = df.dropna(subset=['year', col])\n",
    "        \n",
    "        # 如果存在有效数据，计算跨度\n",
    "        if not valid_data.empty:\n",
    "            min_y = valid_data['year'].min()\n",
    "            max_y = valid_data['year'].max()\n",
    "            span = max_y - min_y\n",
    "            results.append(span)\n",
    "\n",
    "res_df = pd.DataFrame(results)\n",
    "\n",
    "count0 = res_df[0].between(0, 64).sum()\n",
    "count1 = res_df[0].between(0, 80).sum()\n",
    "\n",
    "count2 = res_df[0].between(100, 200).sum()\n",
    "count3 = res_df[0].between(200, 300).sum()\n",
    "count4 = res_df[(res_df[0] >= 200)].shape[0]\n",
    "print(count0, count1,count2,count3,count4)\n"
   ]
  },
