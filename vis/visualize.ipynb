   "id": "762f9974",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy import signal\n",
    "\n",
    "# 1. 读取数据并清理列名\n",
    "full.columns = full.columns.str.strip()  # 去除列名头尾空格\n",
    "\n",
    "# 2. 设置年份为索引并确保数据为数值型\n",
    "if 'year' in full.columns:\n",
    "    full.set_index('year', inplace=True)\n",
    "\n",
    "# 将所有列转换为数值，无法转换的变为 NaN (处理如 'NAN' 字符串)\n",
    "full = full.apply(pd.to_numeric, errors='coerce')\n",
    "\n",
    "# 3. 线性插值（填补中间的缺失值）\n",
    "# limit_area='inside' 表示只填充有效数值中间的空隙，不向两端延伸\n",
    "df_interp = full.interpolate(method='linear', limit_area='inside')\n",
    "\n",
    "full_clean=df_interp\n",
    "\n",
    "# 4. 设计低通滤波器 (Low-pass Filter)\n",
    "# 截止频率 cutoff = 0.2, 采样频率 fs = 1 (假设每年一个点)\n",
    "# 归一化频率 wn = cutoff / (fs / 2)\n",
    "fs = 1.0\n",
    "cutoff = 0.2\n",
    "wn = cutoff / (0.5 * fs)\n",
    "sos = signal.butter(3, wn, btype='low', output='sos')\n",
    "\n",
    "# 5. 准备滤波数据\n",
    "# 注意：滤波函数无法处理 NaN。必须先用 0 或 均值 临时填充头尾的 NaN\n",
    "# 我们先保存原始 NaN 的位置，以便滤波后恢复\n",
    "mask = df_interp.isna()\n",
    "df_filled = df_interp.fillna(0) \n",
    "\n",
    "# 6. 执行向量化滤波 (沿时间轴 axis=0)\n",
    "filtered_array = signal.sosfiltfilt(sos, df_filled.values, axis=0)\n",
    "\n",
    "# 7. 恢复为 DataFrame 并还原头尾的 NaN\n",
    "full_fft = pd.DataFrame(filtered_array, index=df_interp.index, columns=df_interp.columns)\n",
    "full_fft[mask] = np.nan  # 将原本是 NaN 的位置（头尾）重新设为 NaN"
   ]
  },
