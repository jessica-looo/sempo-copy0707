   "source": [
    "import numpy as np\n",
    "def trim_nans(a):\n",
    "    # 1. 找到所有非 NaN 元素的布尔索引 (mask)\n",
    "    mask = ~np.isnan(a)\n",
    "    \n",
    "    # 2. 找到所有非 NaN 元素的整数索引\n",
    "    indices = np.where(mask)[0]\n",
    "    \n",
    "    # 如果数组全是 NaN，返回空数组\n",
    "    if len(indices) == 0:\n",
    "        return np.array([])\n",
    "    \n",
    "    # 3. 提取第一个和最后一个非 NaN 的位置\n",
    "    first_idx = indices[0]\n",
    "    last_idx = indices[-1]\n",
    "    \n",
    "    # 4. 根据索引进行切片（注意切片是左闭右开，所以最后一位要 +1）\n",
    "    return a[first_idx : last_idx + 1]"
   ]
  },
